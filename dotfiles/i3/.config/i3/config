# i3 config - hand-written, lean. Stowed from dotfiles/i3.
#
# Phase 1: i3 is opt-in, swapped in/out via Super+Shift+W (toggle-wm).
# Logging out resets to xfwm4 by default, so nothing here is sticky.
#
# Conventions:
#   Super         = focus / navigation
#   Super+Shift   = move / send / "more powerful" variant
#   Super+letter  = XFCE-mirrored app launch (same chord works in xfwm4)
#
# Where i3's default Super+letter conflicts with an XFCE app-launch
# chord (Super+F = thunar, Super+E = code), the i3 action is shifted to
# Super+Shift+letter so the cross-WM muscle memory stays consistent.

set $mod Mod4

# pango is fine here; only used for window titles and i3bar.
font pango:monospace 10

# Mouse+Super drags floating windows (i3 default; keep it).
floating_modifier $mod

# Don't warp the cursor when focus moves to another output. i3's default
# (mouse_warping output) yanks the pointer to the center of the newly
# focused window whenever cross-output focus changes -- so Ctrl-clicking
# a terminal link on the laptop panel teleports the mouse to Vivaldi on
# the external monitor. "none" keeps the cursor where it is; focus still
# follows the active window, just the cursor doesn't move on its own.
mouse_warping none

#=============================================================================
# Focus + move (the bread and butter)
#=============================================================================

bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

#=============================================================================
# Splits + layouts
#=============================================================================

# Split direction. Super+H splits horizontally (next window lands to
# the right). i3's default Super+V is taken by the XFCE-mirrored
# vivaldi launch below, so split-vertical lives on Super+Shift+V.
bindsym $mod+h split h
bindsym $mod+Shift+v split v

# Layouts. Stacking + tabbed are i3's bread-and-butter.
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed

# Fullscreen on Super+Shift+F (Super+F is thunar, mirrored from XFCE).
bindsym $mod+Shift+f fullscreen toggle

# Toggle floating / focus between floating and tiling.
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

#=============================================================================
# Multi-monitor
#=============================================================================

# Apply the autorandr layout for the currently-connected monitors at
# session start. This is what fixes monitors "not working" after login:
# XFCE's displays.xml sets the geometry at boot but never marks a primary
# output (so i3's primary/nonprimary rules below can't resolve) and may
# pick the wrong external mode. autorandr already has the geometry the
# layout wants, so plain `--change` treats it as "loaded" and skips its
# postswitch hook -- workspaces 3-4 stay stranded on the laptop. --force
# makes it re-apply the saved profile (which sets eDP-1 primary) and run
# the postswitch hook (which migrates workspaces onto the right outputs).
# Hotplug while logged in is handled separately by autorandr's udev rule.
# Plain `exec` (startup only, not exec_always) so reloading the i3 config
# doesn't re-run xrandr and flicker the screen.
exec --no-startup-id autorandr --change --force

# Workspace -> output assignment. 1-2 live on the laptop (primary);
# 3-6 prefer the external monitor (nonprimary) and fall back to the
# laptop when nothing is plugged in. 7-9 are unassigned and open on
# whichever output is currently focused. primary / nonprimary are
# resolved by i3 at runtime, so this stays machine-independent -- no
# hard-coded HDMI/DP output names.
#
# Caveat: i3 only applies these rules when a workspace is created.
# Pre-existing workspaces don't migrate on hotplug -- that's what the
# autorandr postswitch hook (dotfiles/autorandr/.../postswitch) fixes.
# Keep that hook's move list (1-6) in sync with the assignments here.
workspace 1 output primary
workspace 2 output primary
workspace 3 output nonprimary primary
workspace 4 output nonprimary primary
workspace 5 output nonprimary primary
workspace 6 output nonprimary primary

#=============================================================================
# Workspaces
#=============================================================================

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Numpad workspace bindings. NumLock state picks which set fires:
#
#   NumLock ON  -- numpad types digits normally; the modified bindings
#                  ($mod+KP_N, $mod+Shift+KP_N) still let you jump or
#                  move while typing.
#   NumLock OFF -- the numpad becomes a bare workspace switcher; KP_N
#                  emits its NumLock-off nav keysym (KP_End, KP_Down,
#                  KP_Next, KP_Left, KP_Begin, KP_Right, KP_Home, KP_Up,
#                  KP_Prior for 1..9), which i3 grabs even without
#                  Super. Caveat: i3 eats these even mid-text; turn
#                  NumLock on if you want naked End/Home from the
#                  numpad to reach an editor or terminal.
bindsym $mod+KP_1 workspace number 1
bindsym $mod+KP_2 workspace number 2
bindsym $mod+KP_3 workspace number 3
bindsym $mod+KP_4 workspace number 4
bindsym $mod+KP_5 workspace number 5
bindsym $mod+KP_6 workspace number 6
bindsym $mod+KP_7 workspace number 7
bindsym $mod+KP_8 workspace number 8
bindsym $mod+KP_9 workspace number 9

bindsym $mod+Shift+KP_1 move container to workspace number 1
bindsym $mod+Shift+KP_2 move container to workspace number 2
bindsym $mod+Shift+KP_3 move container to workspace number 3
bindsym $mod+Shift+KP_4 move container to workspace number 4
bindsym $mod+Shift+KP_5 move container to workspace number 5
bindsym $mod+Shift+KP_6 move container to workspace number 6
bindsym $mod+Shift+KP_7 move container to workspace number 7
bindsym $mod+Shift+KP_8 move container to workspace number 8
bindsym $mod+Shift+KP_9 move container to workspace number 9

bindsym KP_End   workspace number 1
bindsym KP_Down  workspace number 2
bindsym KP_Next  workspace number 3
bindsym KP_Left  workspace number 4
bindsym KP_Begin workspace number 5
bindsym KP_Right workspace number 6
bindsym KP_Home  workspace number 7
bindsym KP_Up    workspace number 8
bindsym KP_Prior workspace number 9

#=============================================================================
# Resize mode (Super+R -> arrows -> Enter/Esc to exit)
#=============================================================================

mode "resize" {
    bindsym Left  resize shrink width  10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width  10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

#=============================================================================
# Window + session actions
#=============================================================================

bindsym $mod+q kill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+c reload

# Exit i3 -- ends the X session and drops back to LightDM. Confirms via
# i3-nagbar first so it can't be an accidental session-kill. This is the
# in-session escape hatch back to the "Xfce Session" picker.
bindsym $mod+Shift+e exec i3-nagbar -t warning -m 'Exit i3 and end the X session?' -B 'Exit i3' 'i3-msg exit'

# System power. logind permits these for an active local-seat user
# (CanPowerOff/Reboot/Suspend = yes) -- no polkit prompt, no
# xfce4-session dependency. This is why the XFCE panel's greyed Action
# Buttons can't drive them (the plugin gates on org.xfce.SessionManager
# which a pure-i3 session doesn't run); these binds bypass that.
# Reboot is on 'b' (for "boot") because Super+Shift+r is i3's own
# in-place restart above. Suspend has no confirm because waking is one
# keypress away.
bindsym $mod+Shift+p exec i3-nagbar -t warning -m 'Power off the machine?' -B 'Power off' 'systemctl poweroff'
bindsym $mod+Shift+b exec i3-nagbar -t warning -m 'Reboot the machine?' -B 'Reboot' 'systemctl reboot'
bindsym $mod+Shift+s exec systemctl suspend

# Lock the screen with i3lock. IMPORTANT: in this session xfsettingsd owns the
# keyboard-shortcut grabs -- it starts before i3 (see start-xfce-i3 in
# 87-i3.sh) and grabs Ctrl+Alt+L first, so i3's grab silently loses and THIS
# bindsym never actually fires. The command that runs is the xfconf one in
# setup/76-app-hotkeys.sh (<Primary><Alt>l -> i3lock). This line is kept only
# as a mirror/fallback for a hypothetical i3 session with no xfsettingsd, and
# to keep the chord documented alongside the others. Same applies to the
# Super+letter launches above -- xfsettingsd runs those too.
# The command lives in lock.sh (i3lock-color blur+clock, with a vanilla i3lock
# fallback). We use the i3lock family, not xflock4: xflock4 locks under xfwm4
# but no-ops here (its D-Bus Lock to org.xfce.SessionManager finds no
# xfce4-session). Unlike Super+Shift+S (suspend, which freezes every process),
# locking leaves everything running.
bindsym Control+Mod1+l exec --no-startup-id "$HOME/.config/i3/lock.sh"

#=============================================================================
# Launches (mirror the XFCE bindings from setup/76-app-hotkeys.sh)
#=============================================================================

# Terminal. kitty is installed + themed by setup/60-terminal.sh; bind
# directly rather than going through exo-open so this is decoupled from
# XFCE's preferred-applications setting.
bindsym $mod+Return exec kitty

bindsym $mod+c   exec galculator
bindsym $mod+e   exec code
bindsym $mod+v   exec vivaldi
bindsym $mod+f   exec bash -c 'thunar "$HOME"'
bindsym $mod+p   exec copyq toggle
bindsym $mod+F12 exec ulauncher-toggle

# Cheatsheet -- floating terminal viewer for ~/.config/i3/CHEATSHEET.md.
# Bound to Super+? (Super+Shift+slash), the conventional help chord --
# deliberately not an F-key, since those are flaky on the BT keyboard.
# Title is used by the for_window rule below so this terminal opens
# floating + centered, no matter the current layout.
bindsym $mod+Shift+slash exec bash -c 'kitty --title="i3-cheatsheet" -- less $HOME/.config/i3/CHEATSHEET.md'

for_window [title="^i3-cheatsheet$"] floating enable, resize set 900 700, move position center

# CopyQ clipboard window -- Super+P opens `copyq toggle`; force it to
# float, sized + centered on the focused output (i3's `move position
# center` centers on the current output, not under the cursor). WM_CLASS
# is "copyq"/"Copyq" -- match case-insensitively in case it ever shifts.
for_window [class="(?i)copyq"] floating enable, resize set 700 500, move position center

#=============================================================================
# Status bar
#=============================================================================

bar {
    status_command ~/.config/i3/statusline.sh
    position bottom
}
