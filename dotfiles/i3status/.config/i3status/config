# i3status config. Stowed to ~/.config/i3status/config, which i3status
# reads in preference to /etc/i3status.conf. Drives the i3 bottom bar via
# the statusline.sh wrapper (dotfiles/i3/.config/i3/statusline.sh), which
# prepends the average CPU temperature to whatever i3status emits here.
#
# see "man i3status" for documentation.

general {
        colors = true
        interval = 5
}

order += "ipv6"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

wireless _first_ {
        format_up = "W: (%quality at %essid) %ip"
        format_down = "W: down"
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

battery all {
        format = "%status %percentage %remaining"
        # i3status prints a word for %status by default (CHR/BAT/IDLE/FULL).
        # Swap in emoji instead -- rendered via Noto Color Emoji, since the
        # bar font (DejaVu Sans Mono) has no battery glyph. IDLE = plugged in
        # but not charging (e.g. held at a charge threshold).
        status_chr = "⚡"
        status_bat = "🔋"
        status_idle = "🔌"
        status_full = "✅"
        status_unk = "?"
}

disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        format = "%used | %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}
