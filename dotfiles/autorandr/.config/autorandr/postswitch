#!/usr/bin/env bash
# autorandr postswitch hook: realign i3 workspaces with the current
# output set after any layout change. i3's `workspace N output ...`
# directives only fire at workspace creation, so pre-existing workspaces
# don't migrate when monitors come and go, and at login they're often
# created before a primary output is set. Move them explicitly here.
#
# Why concrete output names instead of i3's primary/nonprimary keywords:
# `move workspace to output A B` *cycles* through the list -- if the
# workspace is already on A, i3 moves it to B. So "nonprimary primary"
# is a toggle, not a preference: run it twice and a workspace bounces off
# the external monitor and back onto the laptop. We resolve the actual
# output names from xrandr and move each workspace to exactly one output,
# which makes this hook idempotent -- safe to run on every login and on
# every hotplug, however many times.
#
# No-op when i3 isn't the current WM (xfwm4 session, login screen).

set -eu

command -v i3-msg >/dev/null || exit 0
pgrep -x i3 >/dev/null || exit 0

# Resolve the primary output and the external output (first connected
# output that isn't primary). With no external monitor, external falls
# back to primary, so workspaces 3-4 land on the laptop panel.
primary=$(xrandr --query | awk '/ connected primary/ {print $1; exit}')
[ -n "$primary" ] || primary=$(xrandr --query | awk '/ connected/ {print $1; exit}')
external=$(xrandr --query | awk '/ connected/ && !/ primary/ {print $1; exit}')
[ -n "$external" ] || external=$primary

# Snapshot focused workspace -- `move workspace to output` only acts on
# the focused workspace, so we switch through each one in turn and need
# to restore focus at the end.
focused=$(i3-msg -t get_workspaces | python3 -c '
import json, sys
ws = json.load(sys.stdin)
print(next((w["name"] for w in ws if w["focused"]), ""))
')

# Only move workspaces that already exist; `workspace number N` would
# otherwise create an empty workspace as a side effect.
existing=$(i3-msg -t get_workspaces | python3 -c '
import json, sys
print(" ".join(str(w["num"]) for w in json.load(sys.stdin)))
')

move() {
    local num=$1 out=$2
    case " $existing " in *" $num "*) ;; *) return 0 ;; esac
    i3-msg "workspace number $num; move workspace to output $out" >/dev/null
}

move 1 "$primary"
move 2 "$primary"
move 3 "$external"
move 4 "$external"
move 5 "$external"
move 6 "$external"

# Best-effort focus restore; ignore failure if that workspace is gone.
[ -n "$focused" ] && i3-msg "workspace $focused" >/dev/null || true
