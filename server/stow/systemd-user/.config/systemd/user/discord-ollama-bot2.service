[Unit]
Description=Second Discord bot (arena clone) backed by local Ollama
After=network-online.target ollama.service
Wants=network-online.target

[Service]
WorkingDirectory=%h/personal/discord-ollama-bot
Environment=ENV_FILE=%h/personal/discord-ollama-bot/.env2
ExecStart=%h/personal/discord-ollama-bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
